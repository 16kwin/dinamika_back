# Секреты установки AWMS «ДИНАМИКА» — образец без значений.
#
# Рабочий файл — config/awms-secrets.properties рядом с jar (или абсолютный путь в AWMS_SECRETS_FILE).
# Создаётся командой установки (после пакета B10):  java -jar dinamika_back.jar init-secrets
# Она генерирует ключи; пароли ролей БД вписывает администратор (роли создаёт deploy/db/roles.sql).
# До выкатки B10 служба этот файл не читает.
#
# Права: владелец — администраторы ОС, читает только учётная запись службы. В git, письма и отчёты не попадает.
# Здесь допустимы только ключи ниже: через этот файл нельзя задать функции или параметры потолка.
# Если ключа нет или он совпадает со значением из репозитория — служба не запустится.

# Ключ шифрования токенов входа (JWK), свой у каждой установки
jwt.cookie-token-key=

# Рабочая роль приложения в PostgreSQL: только DML, журналы — только добавление (deploy/db/roles.sql)
spring.datasource.username=awms_app
spring.datasource.password=

# Роль-владелец схемы: под ней Flyway применяет миграции при старте
spring.flyway.user=awms_owner
spring.flyway.password=

# Ключ API для колбэков внешней системы заказов и ТКП
api.key.awms=

# Ключ HMAC-цепочки журнала изменений профиля
awms.journal.hmac-key=

# Ключ шифрования паролей камер
awms.video.credentials-key=

# Пароль хранилища ключей HTTPS — только если служба сама работает по HTTPS (server.ssl.enabled=true)
#server.ssl.key-store-password=
